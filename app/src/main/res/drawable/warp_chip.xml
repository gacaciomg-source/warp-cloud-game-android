<?xml version="1.0" encoding="utf-8"?>
<!-- Opção que se escolhe (qualidade, loja, tamanho). Escolhida: verde. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape><corners android:radius="22dp" /><solid android:color="#3300C48E" /><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="22dp" /><solid android:color="#1FFFFFFF" /><stroke android:width="3dp" android:color="@color/warp_verde" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><corners android:radius="22dp" /><solid android:color="#2900C48E" /><stroke android:width="1.5dp" android:color="@color/warp_verde" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="22dp" /><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="22dp" /><solid android:color="#14FFFFFF" /><stroke android:width="1dp" android:color="#2EFFFFFF" /></shape>
    </item>
</selector>
