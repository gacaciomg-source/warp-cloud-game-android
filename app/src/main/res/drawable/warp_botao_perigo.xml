<?xml version="1.0" encoding="utf-8"?>
<!-- Encerrar a sessão: contorno vermelho, sem chamar atenção demais. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="12dp" /><solid android:color="#40F2545B" /><stroke android:width="1dp" android:color="@color/warp_erro" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="12dp" /><solid android:color="#26F2545B" /><stroke android:width="3dp" android:color="@color/warp_erro" /></shape>
    </item>
    <item>
        <shape><corners android:radius="12dp" /><solid android:color="#14F2545B" /><stroke android:width="1dp" android:color="#99F2545B" /></shape>
    </item>
</selector>
