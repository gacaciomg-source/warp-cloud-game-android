<?xml version="1.0" encoding="utf-8"?>
<!-- Por cima da capa: moldura verde no foco (controle, TV) e um véu ao tocar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="14dp" /><stroke android:width="3dp" android:color="@color/warp_verde" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="14dp" /><solid android:color="#3300C48E" /></shape>
    </item>
    <item>
        <shape><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#22FFFFFF" /></shape>
    </item>
</selector>
