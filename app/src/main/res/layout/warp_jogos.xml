<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo de jogos do Cloud Game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warp_fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:contentDescription="WARP"
            android:src="@drawable/warp_simbolo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="WARP Cloud Game"
            android:textColor="@color/warp_texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/warp_atualizar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Atualizar"
            android:focusable="true"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/warp_texto_2"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/warp_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:focusable="true"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/warp_texto_2"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/warp_grade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:columnWidth="150dp"
            android:horizontalSpacing="14dp"
            android:numColumns="auto_fit"
            android:padding="16dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="14dp" />

        <ProgressBar
            android:id="@+id/warp_carregando"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/warp_verde" />

        <TextView
            android:id="@+id/warp_aviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/warp_apagado"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
