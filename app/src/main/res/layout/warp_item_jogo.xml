<?xml version="1.0" encoding="utf-8"?>
<!-- Um jogo no catálogo: capa, selo e nome.
     Sem focusable aqui: dentro de uma GridView, item focável engole o toque e o
     clique nunca chega (a grade cuida do foco, inclusive no controle da TV). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/warp_cartao"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <ImageView
            android:id="@+id/warp_capa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Capa do jogo"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/warp_selo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/warp_texto"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/warp_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/warp_texto"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
