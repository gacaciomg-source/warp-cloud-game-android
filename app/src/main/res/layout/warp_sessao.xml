<?xml version="1.0" encoding="utf-8"?>
<!-- Fila, conexão e pareamento automático até abrir o jogo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warp_fundo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ProgressBar
        android:id="@+id/warp_giro"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="@color/warp_verde" />

    <TextView
        android:id="@+id/warp_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/warp_verde"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/warp_etapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/warp_texto"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/warp_detalhe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxWidth="420dp"
        android:textColor="@color/warp_apagado"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/warp_sair"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/warp_botao_secundario"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Sair"
        android:textAllCaps="false"
        android:textColor="@color/warp_texto"
        android:textSize="15sp" />
</LinearLayout>
